{
  "name": "arcade",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks && git config blame.ignoreRevsFile ':(optional).git-blame-ignore-revs'",
    "dev": "bun --hot --port=${ARCADE_PORT:-3000} ./index.html",
    "build": "bun build ./index.html --outdir dist --minify",
    "preview": "bunx serve dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "art": "bun scripts/gen-art.ts",
    "sounds": "bun scripts/gen-ui-sounds.ts",
    "frames": "bun scripts/capture-frames.ts",
    "frames:report": "bun scripts/frame-report.ts",
    "traces": "bun scripts/record-traces.ts",
    "verify": "bun scripts/verify.ts",
    "pixel": "bun scripts/pixel.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run knip && bun test && bun run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives && bun scripts/lint-guards.ts",
    "lint:fix": "oxlint --type-aware --fix",
    "knip": "knip --no-progress",
    "sandcastle": "bun .sandcastle/main.ts",
    "sandcastle:batch": "bun .sandcastle/batch.ts"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@types/bun": "1.4.2",
    "@types/pngjs": "6.0.5",
    "knip": "6.41.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "sandworm": "link:sandworm",
    "typescript": "7.0.2"
  }
}
