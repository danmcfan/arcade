{
  "name": "arcade",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "bun --hot --port=${ARCADE_PORT:-3000} ./index.html",
    "build": "bun build ./index.html --outdir dist --minify",
    "preview": "bunx serve dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "art": "bun scripts/gen-ui-art.ts && bun scripts/gen-cabinets.ts && bun scripts/gen-firefly-art.ts",
    "sounds": "bun scripts/gen-ui-sounds.ts",
    "frames": "bun scripts/capture-frames.ts",
    "frames:report": "bun scripts/frame-report.ts",
    "traces": "bun scripts/record-traces.ts",
    "verify": "bun scripts/verify.ts",
    "pixel": "bun scripts/pixel.ts",
    "check": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/pngjs": "6.0.5",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2"
  }
}
